# Secrets of the dev sandbox (dev branch). Copy to dev.env; never commit it.
# Token of a separate dev Cloudflare tunnel (not the prod one). Empty = no tunnel (only http://127.0.0.1:32701).
CLOUDFLARE_TUNNEL_TOKEN=
# Optional fixed Laravel app key (base64:...). Empty = generated once and kept in the database volume.
APP_KEY=
# Optional (public repo): raises GitHub's API rate limit. A fine-grained token with no permissions is enough.
GITHUB_TOKEN=
