# Copy to .env and fill in. Never commit .env.

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > the token from "docker run ... --token <TOKEN>"
CLOUDFLARE_TUNNEL_TOKEN=
# Starts cloudflared. Remove to run without a tunnel (then only http://127.0.0.1:32700 works).
COMPOSE_PROFILES=tunnel

# Where the other parts are, relative to this folder.
API_DIR=./wormix-api
CLIENT_DIR=./wormix-client

# Optional: a fixed Laravel app key (base64:...). Empty = generated once and stored in the data volume.
APP_KEY=

# Optional: environment (production by default; set to dev or local to enable dev starters)
APP_ENV=
