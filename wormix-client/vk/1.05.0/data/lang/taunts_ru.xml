<?xml version="1.0" encoding="UTF-8"?>
<!-- фразы в бою-->
<!-- во всех фразах %source% кто стрелял/чей сейчас ход, %target% в кого попали-->
<taunts>
    <!-- начало хода-->
    <onNextTurn>
        <message>Ховайтеся! %source% зараз стрілятиме!</message>
        <message>Стій! Не стріляй! Ти не прицілився!</message>
		<message>Ось зараз щось буде...</message>
		<message>%source%, твоя черга</message>
		<message>%source% налаштований рішуче</message>
		<message>Гей, %source%, та стріляй уже!</message>
		<message>%source%, що ти ще задумав?</message>
		<message>%source%, схибиш-схибиш!</message>
		<message>%source%, та ти не поспішай, часу багато</message>
		<message>%source%, думаєш, влучиш?</message>
		<message>Стріляй на рахунок три! Один...</message>
		<message>%source%, ти ціляйся, а я поки по кавусю збігаю...</message>
        <message>Є тільки ми: ти, я і мортира!</message>
        <message>%source% прагне крові!</message>
        <message>%source% налаштований дуже рішуче</message>
        <message>%source% в люті!</message>
        <message>%source%, сьогодні не твій день</message>
        <message>Найкращий захист — це напад</message>
        <message>Настає вирішальний момент!</message>
        <message>Час писати заповіт...</message>
        <message>Може, сьогодні %source% влучить?</message>
    </onNextTurn>
    <!-- попал в противника-->
    <onDamage>
        <message>Влучив-влучив!</message>
        <message>Бачили-бачили? Влучив!</message>
		<message>Що тут скажеш.. сам винен!</message>
		<message>А я попереджав: не треба зі мною зв'язуватися!</message>
		<message>Влучив, чи що?</message>
		<message>Шикарно!</message>
		<message>Ти що? Ще не вмер?</message>

		<message>Гей, %target%, ти як там?</message>
		<message>Ну що? Нічого відповісти?</message>
        <message>%target%, здавайся!</message>
        <message>%target%, благай про пощаду!</message>
        <message>Ну все, %target%, ти програв!</message>
        <message>%target%, та скільки в тебе там життів!</message>
        <message>%target%, у гніві я страшний!</message>
        <message>%target%, дістав, так?</message>

        <message>%source%, рано радієш!</message>
        <message>%source%, нарешті ти влучив. Розумничка.</message>
        <message>%source%, що це було?</message>
        <message>%source%, це твій найкращий удар?</message>
        <message>%source%, це й був твій «смертельний удар»?</message>
		<message>%source%, ну насмішив...</message>
		<message>%source%, ти б хоч стріляти навчився.</message>

        <message>Залишається тільки пожаліти тебе</message>

        <message>%target%, як тобі на смак мій порох?</message>
        <message>%target%, погрався і досить</message>
        <message>%target%, здавайся!</message>
        <message>%source%, я помщуся!</message>
        <message>%source%, повтори, ми все пропустили</message>
    </onDamage>
    <!-- попал в себя-->
    <onSelfDamage>
        <message>Щось я не туди стрельнув...</message>
        <message>Ой!</message>
        <message>Я випадково!</message>
        <message>%source%, ти в кого стріляєш?!</message>
		<message>Гей, %source%, давай обережніше!</message>
		<message>Не туди стріляєш!</message>
		<message>Гей, а це за що?</message>
		<message>Я більше не буду!</message>
		<message>Пррробачте...</message>
		<message>Ой, не туди...</message>

        <message>%target% — дурник</message>
        <message>Бий своїх, щоб чужі боялися</message>
        <message>Ось тобі моя порада — цілься в голову</message>
        <message>Я працюю над собою, працюю!!!</message>
        <message>Я тебе породив, я тебе і вб'ю!</message>
        <message>Це я тренуюся</message>
        <message>Без коментарів</message>
        <message>%target% усе переплутав</message>
    </onSelfDamage>
</taunts>